FROM rust:1.82 AS build
WORKDIR /src
COPY services/cim-pds services/cim-pds
COPY data data
RUN cd services/cim-pds && cargo build --release --locked
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/services/cim-pds/target/release/cim-pds /cim-pds
COPY data /data
ENV CIM_DATA_DIR=/data CIM_STATE_DIR=/state
USER nonroot
EXPOSE 8081
ENTRYPOINT ["/cim-pds"]
